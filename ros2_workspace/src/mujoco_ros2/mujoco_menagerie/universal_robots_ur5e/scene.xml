<mujoco model="ur5e_scene">
  
  <include file="ur5e.xml"/>

  
  <statistic center="0.3 0 0.4" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <!-- Textures and materials -->
  <asset>
    <!-- Gradient sky -->
    <texture
      name="skybox"
      type="skybox"
      builtin="gradient"
      rgb1="0.3 0.5 0.7"
      rgb2="0.0 0.0 0.0"
      width="512"
      height="512"/>

    <!-- Ground texture -->
    <texture
      name="groundplane"
      type="2d"
      builtin="checker"
      rgb1="0.9 0.9 0.9"
      rgb2="0.8 0.8 0.8"
      width="300"
      height="300"
      mark="edge"
      markrgb="0.7 0.7 0.7"/>

    <material
      name="groundplane_mat"
      texture="groundplane"
      texuniform="true"/>
  </asset>

  <worldbody>
    <!-- Main light -->
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>

    <!-- Side light -->
    <light pos="2 -2 2" dir="-1 1 -1" diffuse="0.4 0.4 0.4" specular="0.2 0.2 0.2"/>

    <!-- Floor -->
    <geom
      name="floor"
      type="plane"
      size="5 5 0.1"
      material="groundplane_mat"
      rgba="0.9 0.9 0.9 1"/>

    <!-- Conveyor -->
    <body name="conveyor" pos="0.7 0.0 0.05">
      <!-- Belt surface -->
      <geom
        type="box"
        size="0.5 0.1 0.02"
        rgba="0.2 0.2 0.2 1"/>
      <!-- Side rails -->
      <geom
        type="box"
        pos="0 0.12 0.03"
        size="0.5 0.01 0.03"
        rgba="0.1 0.1 0.1 1"/>
      <geom
        type="box"
        pos="0 -0.12 0.03"
        size="0.5 0.01 0.03"
        rgba="0.1 0.1 0.1 1"/>
    </body>

    <!-- Stacking area -->
    <body name="stacking_area" pos="0.3 0.6 0.05">
      <geom
        type="box"
        size="0.15 0.15 0.02"
        rgba="0.1 0.5 0.1 1"/>
    </body>

    <!-- Box on conveyor -->
    <body name="box_on_conveyor" pos="0.8 0.0 0.08">
      <geom
        type="box"
        size="0.03 0.03 0.03"
        rgba="0.8 0.4 0.1 1"
        mass="0.1"/>
    </body>

    <!-- Box on stacking area -->
    <body name="box_on_stack" pos="0.3 0.6 0.08">
      <geom
        type="box"
        size="0.03 0.03 0.03"
        rgba="0.9 0.6 0.2 1"
        mass="0.1"/>
    </body>

    <!-- Work table near the robot -->
    <body name="work_table" pos="-0.4 0.4 0.4">
      <!-- Table top -->
      <geom
        type="box"
        size="0.3 0.2 0.02"
        rgba="0.5 0.3 0.2 1"/>
      <!-- Four legs -->
      <geom
        type="box"
        pos="0.25 0.15 -0.19"
        size="0.02 0.02 0.19"
        rgba="0.3 0.2 0.2 1"/>
      <geom
        type="box"
        pos="-0.25 0.15 -0.19"
        size="0.02 0.02 0.19"
        rgba="0.3 0.2 0.2 1"/>
      <geom
        type="box"
        pos="0.25 -0.15 -0.19"
        size="0.02 0.02 0.19"
        rgba="0.3 0.2 0.2 1"/>
      <geom
        type="box"
        pos="-0.25 -0.15 -0.19"
        size="0.02 0.02 0.19"
        rgba="0.3 0.2 0.2 1"/>
    </body>

    <!-- Toolbox on the table -->
    <body name="toolbox" pos="-0.4 0.55 0.44">
      <geom
        type="box"
        size="0.08 0.05 0.04"
        rgba="0.6 0.1 0.1 1"/>
    </body>

    <!-- Worker figure -->
    <body name="worker" pos="-0.8 0.4 0.0">
      <!-- Body -->
      <geom
        type="cylinder"
        size="0.05 0.3"
        pos="0 0 0.3"
        rgba="0.9 0.8 0.7 1"/>
      <!-- Head -->
      <geom
        type="sphere"
        size="0.07"
        pos="0 0 0.7"
        rgba="0.9 0.8 0.7 1"/>
    </body>

  </worldbody>
</mujoco>

